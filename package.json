{
  "name": "civil-game-jam",
  "private": true,
  "version": "0.1.0",
  "description": "Prompt Engineers — CIVIL GAME JAM 2026",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "zip": "npm run build:single && node scripts/zip.mjs",
    "smoke": "node scripts/smoke.mjs",
    "beyan": "node scripts/beyan.mjs",
    "durum": "node scripts/durum.mjs",
    "adalet": "node scripts/adalet.mjs",
    "yedek": "node scripts/yedek.mjs",
    "panel": "node scripts/panel.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/rubik": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
